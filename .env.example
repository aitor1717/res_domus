# Copy to .env (gitignored) — used by docker-compose for VPS deployment.

# Get a key at https://console.anthropic.com/, or leave this blank and add
# it later via Settings -> AI Manager in the app. Leaving it as a non-empty
# placeholder (e.g. "sk-ant-...") would make the app falsely report AI
# features as already configured, so leave it truly empty until you have a
# real key.
ANTHROPIC_API_KEY=
SECRET_KEY=change-me-to-a-random-string

# HTTP Basic Auth — required once this is reachable on the public internet
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Domain Caddy will request a Let's Encrypt cert for, e.g. resdomus.duckdns.org
DOMAIN=

# Set to 1 to run this instance read-only with sample data instead of your
# own - e.g. for a public demo. Leave BASIC_AUTH_USER/PASS and
# ANTHROPIC_API_KEY blank too in that case. See DEPLOY.md.
DEMO_MODE=
